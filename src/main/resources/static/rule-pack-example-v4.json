      "documentType": "BILL_OF_LADING",
      "left": "DOCUMENT_LOADING_PORT",
      "operator": "EQ",
      "right": "LC_LOADING_PORT",
      "severity": "WARNING",
      "message": "Synthetischer Test: loading-place",
      "sourceReference": "Eigene Testdaten, keine normative Regel",
      "mode": "MANUAL"
