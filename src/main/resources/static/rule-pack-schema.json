{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corporate LC Manager – Rule Packs Schema 1 bis 4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "version",
    "name",
    "origin",
    "license",
    "rightsStatement",
    "rules",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2,
        3,
        4
      ]
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,30}$"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "origin": {
      "enum": [
        "OWN_INTERNAL",
        "ICC_LICENSED"
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "rightsStatement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "tests": {
      "type": "array",
      "minItems": 3,
      "maxItems": 150,
      "items": {
        "$ref": "#/$defs/test"
      }
    },
    "calendars": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/calendar"
      }
    }
  },
