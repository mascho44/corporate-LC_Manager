{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corporate LC Manager – Rule Packs Schema 1 und 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "version",
    "name",
    "origin",
    "license",
    "rightsStatement",
    "rules",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,30}$"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "origin": {
      "enum": [
        "OWN_INTERNAL",
        "ICC_LICENSED"
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "rightsStatement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "tests": {
      "type": "array",
      "minItems": 3,
      "maxItems": 150,
      "items": {
        "$ref": "#/$defs/test"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "documentType",
        "left",
        "operator",
        "right",
        "severity",
        "message",
        "sourceReference"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,30}$"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "documentType": {
          "enum": [
            "COMMERCIAL_INVOICE",
            "PACKING_LIST",
            "BILL_OF_LADING",
            "AIR_WAYBILL",
            "ROAD_CONSIGNMENT_NOTE",
            "CERTIFICATE_OF_ORIGIN",
            "INSURANCE_CERTIFICATE",
            "INSPECTION_CERTIFICATE",
            "BILL_OF_EXCHANGE",
            "BENEFICIARY_CERTIFICATE",
            "QUALITY_CERTIFICATE",
            "COURIER_RECEIPT",
            "ADVISING_LETTER",
            "SWIFT_MT700",
            "ANNEX",
            "OTHER"
          ]
        },
        "left": {
          "enum": [
            "DOCUMENT_AMOUNT",
            "DOCUMENT_CURRENCY",
            "DOCUMENT_DATE",
            "DOCUMENT_ISSUER",
            "DOCUMENT_RECIPIENT",
            "DOCUMENT_GOODS_DESCRIPTION"
          ]
        },
        "right": {
          "enum": [
            "LC_AMOUNT",
            "LC_CURRENCY",
            "LC_EXPIRY_DATE",
            "LC_LATEST_SHIPMENT_DATE",
            "LC_BENEFICIARY",
            "LC_APPLICANT",
            "LC_GOODS_DESCRIPTION",
            "LC_SECOND_BENEFICIARY"
          ]
        },
        "operator": {
          "enum": [
            "EQ",
            "NE",
            "LTE",
            "GTE"
          ]
        },
        "severity": {
          "enum": [
            "WARNING",
            "DISCREPANCY"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sourceReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "mode": {
          "enum": [
            "AUTOMATIC",
            "MANUAL"
          ]
        },
        "conditions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "operator",
              "value"
            ],
            "properties": {
              "field": {
                "enum": [
                  "DOCUMENT_AMOUNT",
                  "DOCUMENT_CURRENCY",
                  "DOCUMENT_DATE",
                  "LC_AMOUNT",
                  "LC_CURRENCY",
                  "LC_EXPIRY_DATE",
                  "LC_LATEST_SHIPMENT_DATE",
                  "DOCUMENT_ISSUER",
                  "DOCUMENT_RECIPIENT",
                  "DOCUMENT_GOODS_DESCRIPTION",
                  "LC_BENEFICIARY",
                  "LC_APPLICANT",
                  "LC_GOODS_DESCRIPTION",
                  "LC_RULE_STANDARD",
                  "LC_TRANSFERRED",
                  "LC_SECOND_BENEFICIARY"
                ]
              },
              "operator": {
                "enum": [
                  "EQ",
                  "NE"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "left": {
                "const": "DOCUMENT_AMOUNT"
              }
            }
          },
          "then": {
            "properties": {
              "right": {
                "const": "LC_AMOUNT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "left": {
                "const": "DOCUMENT_CURRENCY"
              }
            }
          },
          "then": {
            "properties": {
              "right": {
                "const": "LC_CURRENCY"
              },
              "operator": {
                "enum": [
                  "EQ",
                  "NE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "left": {
                "const": "DOCUMENT_DATE"
              }
            }
          },
          "then": {
            "properties": {
              "right": {
                "enum": [
                  "LC_EXPIRY_DATE",
                  "LC_LATEST_SHIPMENT_DATE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "left": {
                "const": "DOCUMENT_ISSUER"
              }
            }
          },
          "then": {
            "properties": {
              "right": {
                "enum": [
                  "LC_BENEFICIARY",
                  "LC_SECOND_BENEFICIARY"
                ]
              },
              "operator": {
                "enum": [
                  "EQ",
                  "NE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "left": {
                "const": "DOCUMENT_RECIPIENT"
              }
            }
          },
          "then": {
            "properties": {
              "right": {
                "enum": [
                  "LC_APPLICANT"
                ]
              },
              "operator": {
                "enum": [
                  "EQ",
                  "NE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "left": {
                "const": "DOCUMENT_GOODS_DESCRIPTION"
              }
            }
          },
          "then": {
            "properties": {
              "right": {
                "enum": [
                  "LC_GOODS_DESCRIPTION"
                ]
              },
              "operator": {
                "enum": [
                  "EQ",
                  "NE"
                ]
              },
              "mode": {
                "const": "MANUAL"
              }
            },
            "required": [
              "mode"
            ]
          }
        }
      ]
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ruleId",
        "left",
        "right",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "ruleId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,30}$"
        },
        "left": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "right": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "expected": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUABLE",
            "NOT_APPLICABLE",
            "MANUAL_REVIEW"
          ]
        },
        "facts": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "enum": [
              "DOCUMENT_AMOUNT",
              "DOCUMENT_CURRENCY",
              "DOCUMENT_DATE",
              "LC_AMOUNT",
              "LC_CURRENCY",
              "LC_EXPIRY_DATE",
              "LC_LATEST_SHIPMENT_DATE",
              "DOCUMENT_ISSUER",
              "DOCUMENT_RECIPIENT",
              "DOCUMENT_GOODS_DESCRIPTION",
              "LC_BENEFICIARY",
              "LC_APPLICANT",
              "LC_GOODS_DESCRIPTION",
              "LC_RULE_STANDARD",
              "LC_TRANSFERRED",
              "LC_SECOND_BENEFICIARY"
            ]
          },
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "rules": {
            "items": {
              "properties": {
                "left": {
                  "enum": [
                    "DOCUMENT_AMOUNT",
                    "DOCUMENT_CURRENCY",
                    "DOCUMENT_DATE"
                  ]
                },
                "right": {
                  "enum": [
                    "LC_AMOUNT",
                    "LC_CURRENCY",
                    "LC_EXPIRY_DATE",
                    "LC_LATEST_SHIPMENT_DATE"
                  ]
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "mode"
                    ]
                  },
                  {
                    "required": [
                      "conditions"
                    ]
                  }
                ]
              }
            }
          },
          "tests": {
            "items": {
              "not": {
                "required": [
                  "facts"
                ]
              },
              "properties": {
                "expected": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "NOT_EVALUABLE"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
