{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Corporate LC Manager – eigene interne Rule Packs",
 "type": "object",
 "additionalProperties": false,
 "required": ["schemaVersion","packId","version","name","origin","license","rightsStatement","rules","tests"],
 "properties": {
  "schemaVersion": {"const":1},
  "packId": {"type":"string","pattern":"^[a-z][a-z0-9-]{2,30}$"},
  "version": {"$ref":"#/$defs/version"},
  "name": {"type":"string","minLength":1,"maxLength":100},
  "origin": {"enum":["OWN_INTERNAL","ICC_LICENSED"]},
  "license": {"type":"string","minLength":1,"maxLength":100},
  "rightsStatement": {"type":"string","minLength":1,"maxLength":500},
  "rules": {"type":"array","minItems":1,"maxItems":25,"items":{"$ref":"#/$defs/rule"}},
  "tests": {"type":"array","minItems":3,"maxItems":150,"items":{"$ref":"#/$defs/test"}}
 },
 "$defs": {
  "version": {"type":"string","pattern":"^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$"},
  "rule": {
   "type":"object","additionalProperties":false,
   "required":["id","version","documentType","left","operator","right","severity","message","sourceReference"],
   "properties": {
    "id":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,30}$"},
    "version":{"$ref":"#/$defs/version"},
    "documentType":{"enum":["COMMERCIAL_INVOICE","PACKING_LIST","BILL_OF_LADING","AIR_WAYBILL","ROAD_CONSIGNMENT_NOTE","CERTIFICATE_OF_ORIGIN","INSURANCE_CERTIFICATE","INSPECTION_CERTIFICATE","BILL_OF_EXCHANGE","BENEFICIARY_CERTIFICATE","QUALITY_CERTIFICATE","COURIER_RECEIPT","ADVISING_LETTER","SWIFT_MT700","ANNEX","OTHER"]},
    "left":{"enum":["DOCUMENT_AMOUNT","DOCUMENT_CURRENCY","DOCUMENT_DATE"]},
    "right":{"enum":["LC_AMOUNT","LC_CURRENCY","LC_EXPIRY_DATE","LC_LATEST_SHIPMENT_DATE"]},
    "operator":{"enum":["EQ","NE","LTE","GTE"]},
    "severity":{"enum":["WARNING","DISCREPANCY"]},
    "message":{"type":"string","minLength":1,"maxLength":200},
    "sourceReference":{"type":"string","minLength":1,"maxLength":160}
   },
   "allOf":[
    {"if":{"properties":{"left":{"const":"DOCUMENT_AMOUNT"}}},"then":{"properties":{"right":{"const":"LC_AMOUNT"}}}},
    {"if":{"properties":{"left":{"const":"DOCUMENT_CURRENCY"}}},"then":{"properties":{"right":{"const":"LC_CURRENCY"},"operator":{"enum":["EQ","NE"]}}}},
    {"if":{"properties":{"left":{"const":"DOCUMENT_DATE"}}},"then":{"properties":{"right":{"enum":["LC_EXPIRY_DATE","LC_LATEST_SHIPMENT_DATE"]}}}}
   ]
  },
  "test": {
   "type":"object","additionalProperties":false,
   "required":["name","ruleId","left","right","expected"],
   "properties": {
    "name":{"type":"string","minLength":1,"maxLength":100},
    "ruleId":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,30}$"},
    "left":{"type":["string","null"],"maxLength":100},
    "right":{"type":["string","null"],"maxLength":100},
    "expected":{"enum":["PASS","FAIL","NOT_EVALUABLE"]}
   }
  }
 }
}
