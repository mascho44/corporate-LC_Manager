{
  "schemaVersion": 3,
  "packId": "internal-multidoc-v3-demo",
  "version": "1.0.0",
  "name": "Eigene synthetische Mehrdokument-Prüfungen – Schema 3",
  "origin": "OWN_INTERNAL",
  "license": "INTERNAL_TEST_ONLY",
  "rightsStatement": "Eigener synthetischer Funktionstest, keine normative ICC-Prüfung. Prozentwerte, Tage und Schließtag sind frei gewählte Testdaten; keine produktiven Standardwerte. Vor Aktivierung fachlich freigeben.",
  "rules": [
    {
      "id": "insurance-min",
      "version": "1.0.0",
      "documentType": "INSURANCE_CERTIFICATE",
      "left": "DOCUMENT_INSURED_AMOUNT",
      "operator": "PERCENT_GTE",
      "right": "PEER_AMOUNT",
      "severity": "WARNING",
      "message": "Test: Versicherte Summe mit geprüftem Prozentwert der zugeordneten Rechnung vergleichen.",
      "sourceReference": "Eigener synthetischer Funktionstest V3-insurance-min",
      "mode": "AUTOMATIC",
      "parameters": {
        "peerDocumentType": "COMMERCIAL_INVOICE",
        "percentField": "LC_INSURANCE_MIN_PERCENT"
      }
    },
    {
      "id": "coverage-start",
      "version": "1.0.0",
      "documentType": "INSURANCE_CERTIFICATE",
      "left": "DOCUMENT_INSURANCE_EFFECTIVE_DATE",
      "operator": "LTE",
      "right": "PEER_SHIPMENT_DATE",
      "severity": "WARNING",
      "message": "Test: Geprüften Deckungsbeginn gegen Versanddatum des zugeordneten Transportdokuments vergleichen.",
      "sourceReference": "Eigener synthetischer Funktionstest V3-coverage-start",
      "mode": "AUTOMATIC",
      "parameters": {
        "peerDocumentType": "BILL_OF_LADING"
      }
    },
    {
      "id": "quantity-match",
      "version": "1.0.0",
      "documentType": "COMMERCIAL_INVOICE",
      "left": "DOCUMENT_QUANTITY",
      "operator": "EQ",
      "right": "PEER_QUANTITY",
      "severity": "WARNING",
      "message": "Test: Erfasste Mengen mit der zugeordneten Packliste vergleichen; gleiche Einheit erforderlich.",
      "sourceReference": "Eigener synthetischer Funktionstest V3-quantity-match",
      "mode": "AUTOMATIC",
      "parameters": {
        "peerDocumentType": "PACKING_LIST"
      }
    },
    {
      "id": "invoice-tolerance",
      "version": "1.0.0",
      "documentType": "COMMERCIAL_INVOICE",
      "left": "DOCUMENT_AMOUNT",
      "operator": "WITHIN_TOLERANCE",
      "right": "LC_AMOUNT",
      "severity": "WARNING",
      "message": "Test: Betrag innerhalb ausdrücklich erfasster Toleranz prüfen; keine automatische LC-Toleranzannahme.",
      "sourceReference": "Eigener synthetischer Funktionstest V3-invoice-tolerance",
      "mode": "AUTOMATIC",
      "parameters": {
        "percentField": "LC_TOLERANCE_PERCENT"
      }
    },
    {
      "id": "shipment-deadline",
      "version": "1.0.0",
      "documentType": "BILL_OF_LADING",
      "left": "DOCUMENT_SHIPMENT_DATE",
      "operator": "LTE",
      "right": "LC_LATEST_SHIPMENT_DATE",
      "severity": "WARNING",
      "message": "Test: Fachlich geprüftes Versanddatum gegen die gültige LC-Grenze vergleichen.",
      "sourceReference": "Eigener synthetischer Funktionstest V3-shipment-deadline",
      "mode": "AUTOMATIC"
    },
    {
      "id": "presentation-window",
      "version": "1.0.0",
      "documentType": "BILL_OF_LADING",
      "left": "DOCUMENT_SHIPMENT_DATE",
      "operator": "WITHIN_DAYS",
      "right": "LC_PRESENTATION_DATE",
      "severity": "WARNING",
      "message": "Test: Vorlagefenster ab geprüftem Versanddatum mit ausdrücklich erfasster Tagesgrenze prüfen.",
      "sourceReference": "Eigener synthetischer Funktionstest V3-presentation-window",
      "mode": "AUTOMATIC",
      "parameters": {
        "daysField": "LC_PRESENTATION_PERIOD_DAYS"
      }
    },
    {
      "id": "bank-window",
      "version": "1.0.0",
      "documentType": "BILL_OF_LADING",
      "left": "DOCUMENT_EXAMINATION_START_DATE",
      "operator": "WITHIN_DAYS",
      "right": "LC_EXAMINATION_DECISION_DATE",
      "severity": "WARNING",
      "message": "Test: Geprüfte Prüfbeginn-/Entscheidungsdaten anhand eines ausdrücklich konfigurierten Bankkalenders vergleichen.",
      "sourceReference": "Eigener synthetischer Funktionstest V3-bank-window",
      "mode": "AUTOMATIC",
      "parameters": {
        "days": 2,
        "calendarId": "demo-bank"
      }
    },
    {
      "id": "signature-status",
      "version": "1.0.0",
      "documentType": "INSURANCE_CERTIFICATE",
      "left": "DOCUMENT_SIGNED",
      "operator": "EQ",
      "right": "LC_SIGNATURE_REQUIRED",
      "severity": "WARNING",
      "message": "Test: Geprüften Unterschriftsstatus nur bei ausdrücklich geforderter Unterschrift vergleichen.",
      "sourceReference": "Eigener synthetischer Funktionstest V3-signature-status",
      "mode": "AUTOMATIC",
      "conditions": [
        {
          "field": "LC_SIGNATURE_REQUIRED",
          "operator": "EQ",
          "value": "true"
        }
      ]
    },
    {
      "id": "original-count",
      "version": "1.0.0",
      "documentType": "BILL_OF_LADING",
      "left": "DOCUMENT_ORIGINAL_COUNT",
      "operator": "GTE",
      "right": "LC_REQUIRED_ORIGINAL_COUNT",
      "severity": "WARNING",
      "message": "Test: Fachlich geprüfte Originalanzahl gegen die LC-Anforderung dieses Dokumenttyps vergleichen.",
      "sourceReference": "Eigener synthetischer Funktionstest V3-original-count",
      "mode": "AUTOMATIC",
      "conditions": [
        {
          "field": "LC_REQUIRED_ORIGINAL_COUNT",
          "operator": "NE",
          "value": "0"
        }
      ]
    },
    {
      "id": "risk-review",
      "version": "1.0.0",
      "documentType": "INSURANCE_CERTIFICATE",
      "left": "DOCUMENT_INSURANCE_RISKS",
      "operator": "EQ",
      "right": "LC_INSURANCE_RISKS",
      "severity": "WARNING",
      "message": "Erfasste Risiken und LC-Anforderungen fachlich vergleichen; Wortgleichheit genügt nicht zur Bestätigung.",
      "sourceReference": "Eigener synthetischer Funktionstest V3-risk-review",
      "mode": "MANUAL"
    }
  ],
